# Copy to .env and fill in. Never commit .env.
#
# A Pro or Enterprise scope key. See docs/API_KEYS.md.
#   phx_api_power_  Pro
#   phx_api_int_    Pro
#   phx_api_unl_    Enterprise
# A phx_gintel_ key alone will NOT work.
PHOENIX_API_KEY=phx_api_power_replace_me

# Base URL of your Phoenix instance.
PHOENIX_API_URL=https://phxintel.security

# MCP endpoint. Defaults to $PHOENIX_API_URL/api/v1/mcp
PHOENIX_MCP_URL=https://phxintel.security/api/v1/mcp
